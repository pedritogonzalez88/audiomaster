{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audiomaster",
  "version": "0.1.0",
  "identifier": "com.audiomaster.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audiomaster — On Air",
        "width": 1680,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0c0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Broadcast playout and automation studio",
    "longDescription": "Audiomaster is a cross-platform radio and TV playout automation studio with a media library, cart wall, scheduler and audited on-air playout.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
